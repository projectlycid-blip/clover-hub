    btn.TextSize = 11
    btn.ZIndex = 6
    mkCorner(btn, 7)
    local stroke = mkStroke(btn, C.borderDim, 1)
    btn.MouseButton1Click:Connect(function() showPage(name) end)
    pageButtons[name] = {button=btn, stroke=stroke}
    return page
end

