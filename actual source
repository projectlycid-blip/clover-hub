    end
    if data.lagCarrySpeed then
        State.lagCarrySpeed = data.lagCarrySpeed
        if lagCarrySpeedBox then lagCarrySpeedBox.Text = tostring(data.lagCarrySpeed) end
    end
    State.aimbotSpeed = 56.5
