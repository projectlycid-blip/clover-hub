        State.antiRagdollEnabled = data.antiRagdoll; toggleRefs.antiRagdoll(data.antiRagdoll)
        if data.antiRagdoll then startAntiRagdoll() else stopAntiRagdoll() end
    end
    if data.medusaCounter ~= nil and toggleRefs.medusaCounter then
        State.medusaCounterEnabled = data.medusaCounter; toggleRefs.medusaCounter(data.medusaCounter)
        if data.medusaCounter then setupMedusaCounter(LP.Character) else stopMedusaCounter() end
    end
    if data.batCounter ~= nil and toggleRefs.batCounter then
        State.batCounterEnabled = data.batCounter; toggleRefs.batCounter(data.batCounter)
        if data.batCounter then startBatCounter() else stopBatCounter() end
    end
    if data.autoSteal ~= nil and toggleRefs.autoSteal then
        Steal.AutoStealEnabled = data.autoSteal; State.autoStealEnabled = data.autoSteal
        toggleRefs.autoSteal(data.autoSteal)
        if data.autoSteal then pcall(startAutoSteal) else stopAutoSteal() end
    end
    if data.speedToggled ~= nil and toggleRefs.carryMode then
        State.speedToggled = data.speedToggled; toggleRefs.carryMode(data.speedToggled)
        if setCS then setCS(data.speedToggled) end
    end
    if data.laggerEnabled ~= nil and toggleRefs.laggerMode then
        State.laggerEnabled = data.laggerEnabled; toggleRefs.laggerMode(data.laggerEnabled)
        if setLG then setLG(data.laggerEnabled) end
    end
    if data.laggerMode ~= nil then
        State.laggerMode = data.laggerMode
        if laggerModeBtn then
            if State.laggerMode == 0 then laggerModeBtn.Text = "Lagger Mode"
            elseif State.laggerMode == 1 then laggerModeBtn.Text = "Lagger Speed"
            else laggerModeBtn.Text = "Lag Carry" end
        end
    end
    if data.unwalkEnabled ~= nil and toggleRefs.unwalk then
        State.unwalkEnabled = data.unwalkEnabled; toggleRefs.unwalk(data.unwalkEnabled)
        if data.unwalkEnabled then startUnwalk() else stopUnwalk() end
    end
    if data.batAimbotToggled ~= nil and toggleRefs.aimbot then
        State.batAimbotToggled = data.batAimbotToggled; toggleRefs.aimbot(data.batAimbotToggled)
        if setAB then setAB(data.batAimbotToggled) end
        if data.batAimbotToggled then pcall(startBatAimbot) else stopBatAimbot() end
    end
    if type(data.keys) == "table" then
        local function tryRestoreKey(keyName, kt)
            if data.keys[keyName] then
                if data.keys[keyName] == "Unknown" or data.keys[keyName] == "--" then
                    Keys[kt] = Enum.KeyCode.Unknown
                    if keybindBtnRefs[kt] then keybindBtnRefs[kt].Text = "--" end
                elseif Enum.KeyCode[data.keys[keyName]] then
                    Keys[kt] = Enum.KeyCode[data.keys[keyName]]
                    if keybindBtnRefs[kt] then keybindBtnRefs[kt].Text = getKeyName(Keys[kt]) end
                end
            end
        end
        tryRestoreKey("speed","speed"); tryRestoreKey("lagger","lagger"); tryRestoreKey("autoLeft","autoLeft")
        tryRestoreKey("autoRight","autoRight"); tryRestoreKey("drop","drop"); tryRestoreKey("tpDown","tpDown")
        tryRestoreKey("aimbot","aimbot")
        tryRestoreKey("autoSteal","autoSteal")
    end
    if type(data.guiPositions) == "table" then
        for k, v in pairs(data.guiPositions) do SavedPositions[k] = v end
        task.defer(function()
            local frameMap = {mainOuter=mainOuter, mainReopen=reopenBtn, autoStealBar=progressGui}
