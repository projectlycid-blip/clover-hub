end

local function syncActiveConfigSnapshot()
    if not State.activeConfigName or State.activeConfigName == "" then return end
    for i, cfg in ipairs(Configs) do
        if cfg.name == State.activeConfigName then
            Configs[i].data = buildConfigSnapshot()
            saveConfigsFile()
            if rebuildConfigList then rebuildConfigList() end
            return
        end
    end
end

local function loadConfigsFile()
    local hasFile=false; pcall(function() hasFile=_isfile(CONFIG_SAVE_FILE) end)
    if not hasFile then
        local hasLegacy=false; pcall(function() hasLegacy=_isfile("cloverhubPresets.json") end)
        if hasLegacy then
            local raw; pcall(function() raw=_readfile("cloverhubPresets.json") end)
            if raw then
                local ok,decoded=pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and decoded then Configs=decoded end
            end
        end
        return
    end
    local raw; pcall(function() raw=_readfile(CONFIG_SAVE_FILE) end)
    if not raw then return end
    local ok,decoded=pcall(function() return HttpService:JSONDecode(raw) end)
    if ok and decoded then Configs=decoded end
end

