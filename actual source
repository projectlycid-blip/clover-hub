local function loadConfig()
    local has = false
    pcall(function() has = _isfile(CONFIG_FILE) end)
    if not has then return end
    local raw
    pcall(function() raw = _readfile(CONFIG_FILE) end)
    if not raw then return end
    local cfg
    local ok = pcall(function() cfg = HttpService:JSONDecode(raw) end)
    if not ok or not cfg then return end

    if cfg.normalSpeed then State.normalSpeed = cfg.normalSpeed end
    if cfg.carrySpeed then State.carrySpeed = cfg.carrySpeed end
    if cfg.laggerSpeed then State.laggerSpeed = cfg.laggerSpeed end
    if cfg.lagCarrySpeed then State.lagCarrySpeed = cfg.lagCarrySpeed end
    State.aimbotSpeed = 56.5
    if cfg.stealRadius then Steal.StealRadius = cfg.stealRadius end
    if type(cfg.positions) == "table" then SavedPositions = cfg.positions end

    local function tryKey(field, kt)
        if cfg[field] then
            if cfg[field] == "Unknown" or cfg[field] == "--" then
                Keys[kt] = Enum.KeyCode.Unknown
            elseif Enum.KeyCode[cfg[field]] then
                Keys[kt] = Enum.KeyCode[cfg[field]]
            end
        end
    end
    tryKey("speedKey", "speed")
    tryKey("autoLeftKey", "autoLeft")
    tryKey("autoRightKey", "autoRight")
    tryKey("dropKey", "drop")
    tryKey("laggerKey", "lagger")
    tryKey("tpDownKey", "tpDown")
    tryKey("aimbotKey", "aimbot")
    tryKey("autoStealKey", "autoSteal")
end

local function serializePos(pos)
    return {
        xScale = pos.X.Scale,
        xOffset = pos.X.Offset,
        yScale = pos.Y.Scale,
        yOffset = pos.Y.Offset,
    }
end

local function deserializePos(data, fallback)
    if type(data) ~= "table" then return fallback end
    return UDim2.new(
        tonumber(data.xScale) or fallback.X.Scale,
        tonumber(data.xOffset) or fallback.X.Offset,
        tonumber(data.yScale) or fallback.Y.Scale,
        tonumber(data.yOffset) or fallback.Y.Offset
    )
end

local function applySavedPosition(frame, key)
    if SavedPositions[key] then
        frame.Position = deserializePos(SavedPositions[key], frame.Position)
    end
end

local function saveFramePosition(key, frame)
    SavedPositions[key] = serializePos(frame.Position)
    task.spawn(saveConfig)
end

local function watchFramePosition(key, frame)
    local token = 0
    frame:GetPropertyChangedSignal("Position"):Connect(function()
        SavedPositions[key] = serializePos(frame.Position)
        token = token + 1
        local current = token
        task.delay(0.25, function()
            if token == current then
                pcall(saveConfig)
            end
        end)
    end)
end

