performSaveNamedConfig = function(nm)
    local snapshot = buildConfigSnapshot()
    local found = false
    for i, p in ipairs(Configs) do
        if p.name == nm then Configs[i].data = snapshot; found = true; break end
    end
    if not found then table.insert(Configs, {name=nm, data=snapshot}) end
    State.activeConfigName = nm
    saveLastConfigName(nm)
    saveConfigsFile()
    rebuildConfigList()
end

