UIS.InputChanged:Connect(function(input)
    if pDragActive then
        if State.uiLocked then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - pDragStart
        mbGroup.Position = UDim2.new(mbGroup.Position.X.Scale, pStartPos.X + delta.X, mbGroup.Position.Y.Scale, pStartPos.Y + delta.Y)
        toggleFrame.Position = UDim2.new(toggleFrame.Position.X.Scale, tStartPosLinked.X + delta.X, toggleFrame.Position.Y.Scale, tStartPosLinked.Y + delta.Y)
    elseif tDragActive and toggleDraggingEnabled then
        if State.uiLocked then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = Vector2.new(input.Position.X, input.Position.Y) - tDragStart
        toggleFrame.Position = UDim2.new(toggleFrame.Position.X.Scale, tStartPos.X + delta.X, toggleFrame.Position.Y.Scale, tStartPos.Y + delta.Y)
    end
end)

