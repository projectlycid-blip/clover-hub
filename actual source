local function makeMobileBtn(label, col, row, isToggle, onAction)
    local frame = Instance.new("Frame", mbButtonsWrap)
    frame.LayoutOrder = row * 2 + col + 1
    frame.Size = UDim2.new(0, 1, 0, 1)
    frame.BackgroundColor3 = Q_OFF
    frame.BackgroundTransparency = GUI_TRANSPARENCY
    frame.BorderSizePixel = 0; frame.Active = true; frame.ZIndex = 102; mkCorner(frame, 10)

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""
    btn.TextColor3 = Q_TEXT; btn.Font = Enum.Font.GothamBold; btn.TextSize = 11
    btn.TextWrapped = true; btn.LineHeight = 1.25; btn.BorderSizePixel = 0
    btn.AutoButtonColor = false; btn.ZIndex = 103

    local parts = string.split(label, "\n")
    local topText = parts[1] or label
    local bottomText = parts[2] or ""

    local topLbl = Instance.new("TextLabel", btn)
    topLbl.Size = UDim2.new(1, 0, 0.52, 0); topLbl.Position = UDim2.new(0, 0, 0.06, 0)
    topLbl.BackgroundTransparency = 1; topLbl.Text = topText
    topLbl.TextColor3 = Q_TEXT; topLbl.Font = Enum.Font.GothamBlack; topLbl.TextSize = 11
    topLbl.TextXAlignment = Enum.TextXAlignment.Center; topLbl.ZIndex = 104

    local bottomLbl = Instance.new("TextLabel", btn)
    bottomLbl.Size = UDim2.new(1, 0, 0.44, 0); bottomLbl.Position = UDim2.new(0, 0, 0.52, 0)
    bottomLbl.BackgroundTransparency = 1; bottomLbl.Text = bottomText
    bottomLbl.TextColor3 = Q_TEXT; bottomLbl.Font = Enum.Font.GothamBlack; bottomLbl.TextSize = 11
    bottomLbl.TextXAlignment = Enum.TextXAlignment.Center; bottomLbl.ZIndex = 104

    local isOn = false
    btn.MouseButton1Click:Connect(function()
        if isToggle then
            isOn = not isOn
            TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundColor3 = isOn and Q_ON or Q_OFF}):Play()
            topLbl.TextColor3 = Q_TEXT_ON; bottomLbl.TextColor3 = Q_TEXT_ON
            if onAction then onAction(isOn) end
        else
            TweenService:Create(frame, TweenInfo.new(0.08), {BackgroundColor3 = Q_ON}):Play()
            task.delay(0.25, function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundColor3 = Q_OFF}):Play() end)
            if onAction then onAction() end
        end
    end)

    local function setter(s)
        isOn = s
        TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundColor3 = s and Q_ON or Q_OFF}):Play()
        topLbl.TextColor3 = Q_TEXT_ON; bottomLbl.TextColor3 = Q_TEXT_ON
    end
    return frame, setter, topLbl, bottomLbl
end

